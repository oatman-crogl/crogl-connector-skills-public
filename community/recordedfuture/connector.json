{
  "display_name": "Recorded Future",
  "cli_entrypoint": "recordedfuture.py",
  "credential_schema": {
    "fields": [
      {
        "key": "api_key",
        "label": "API token",
        "description": "Recorded Future API token (sent as the X-RFToken header). Generated by an Enterprise Administrator under the org's Recorded Future account.",
        "kind": "string",
        "secret": true,
        "required": true
      }
    ],
    "binding": {
      "base_url": "https://api.recordedfuture.com",
      "headers": [
        {
          "name": "X-RFToken",
          "template": "{{secret}}",
          "secret_field": "api_key"
        }
      ]
    }
  }
}
